import axios from "axios";
import { api } from "../lib/api";
import { useAuthStore } from "../features/auth/presentation/stores/auth.store";

export function AuthConfig() {
  const base = new URL(api.defaults.baseURL!);
  const apiPath = `${base.pathname.replace(/\/$/, "")}/`;
  const loginPath = `${apiPath}auth/login`;

  const requestId = api.interceptors.request.use((config) => {
    const destino = new URL(api.getUri(config), window.location.origin);

    const destinoPermitido =
      destino.protocol === "https:" &&
      destino.origin === base.origin &&
      destino.pathname.startsWith(apiPath);

    if (!destinoPermitido) {
      throw new Error("Destino no permitido para este cliente HTTP.");
    }

    const { token } = useAuthStore.getState();
    const esLogin = destino.pathname === loginPath;

    if (token && !esLogin) {
      config.headers.set("Authorization", `Bearer ${token}`);
    } else {
      config.headers.delete("Authorization");
    }

    return config;
  });

  const responseId = api.interceptors.response.use(
    (response) => response,
    (error: unknown) => {
      if (axios.isAxiosError(error) && error.response?.status === 401) {
        const { token, logout } = useAuthStore.getState();
        const tokenEnviado = error.config?.headers?.get("Authorization");

        // Una petición de una sesión anterior no debe cerrar la nueva.
        if (token && tokenEnviado === `Bearer ${token}`) {
          logout();
        }
      }

      return Promise.reject(error);
    },
  );

  return () => {
    api.interceptors.request.eject(requestId);
    api.interceptors.response.eject(responseId);
  };
}